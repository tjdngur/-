@st.cache_resource
def load_model(model_path, model_mtime):
    checkpoint = torch.load(
        model_path, map_location="cpu", weights_only=True
    )
    classes = checkpoint["classes"]

    weights = EfficientNet_B0_Weights.DEFAULT
    model = efficientnet_b0(weights=None)
    in_features = model.classifier[1].in_features
    model.classifier[1] = nn.Linear(in_features, len(classes))
    model.load_state_dict(checkpoint["state_dict"])
    model.eval()

    return model, classes, weights.transforms()


def predict(image, model, classes, preprocess):
    image = ImageOps.exif_transpose(image).convert("RGB")
    tensor = preprocess(image).unsqueeze(0)

    with torch.inference_mode():
        logits = model(tensor)
        probabilities = torch.softmax(logits, dim=1)[0]

    order = torch.argsort(probabilities, descending=True)
    results = [
        (classes[i], float(probabilities[i]))
        for i in order.tolist()
    ]
    return results


def korean_label(class_name, info):
    custom = info.get("labels_kr", {})
    return custom.get(
        class_name, LABELS_KR.get(class_name, class_name)
    )


def save_training_images(files, class_name):
    destination = DATA_DIR / "train" / class_name
    destination.mkdir(parents=True, exist_ok=True)

    saved = 0
    for index, uploaded in enumerate(files):
        try:
            image = Image.open(uploaded)
            image = ImageOps.exif_transpose(image).convert("RGB")
            image.thumbnail((2000, 2000))

            # 파일명은 사용자 입력을 사용하지 않고 새로 생성
            output = destination / f"upload_{index:04d}.jpg"
            counter = 1
            while output.exists():
                output = destination / f"upload_{index:04d}_{counter}.jpg"
                counter += 1

            image.save(output, "JPEG", quality=95)
            saved += 1
        except (UnidentifiedImageError, OSError, ValueError):
            st.warning(f"{uploaded.name}: 이미지로 읽을 수 없습니다.")

    return saved


