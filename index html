import copy
import json
import random
from pathlib import Path

import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
from torchvision.models import efficientnet_b0, EfficientNet_B0_Weights


ROOT = Path(__file__).parent
DATA_DIR = ROOT / "data"
MODEL_DIR = ROOT / "models"
MODEL_PATH = MODEL_DIR / "best_model.pth"
INFO_PATH = MODEL_DIR / "model_info.json"

IMAGE_SIZE = 224
BATCH_SIZE = 16
EPOCHS = 20
PATIENCE = 5
SEED = 42

LABELS_KR = {
    "0_normal": "정상",
    "1_mild": "경미한 긁힘",
    "2_moderate": "중간 긁힘",
    "3_severe": "심한 긁힘",
}


def main():
    random.seed(SEED)
    np.random.seed(SEED)
    torch.manual_seed(SEED)

    device = torch.device(
        "cuda" if torch.cuda.is_available() else
        "mps" if torch.backends.mps.is_available() else
        "cpu"
    )
    print(f"학습 장치: {device}")

    train_dir = DATA_DIR / "train"
    val_dir = DATA_DIR / "val"

    if not train_dir.exists() or not val_dir.exists():
        raise FileNotFoundError(
            "data/train과 data/val 폴더를 먼저 만들어 주세요."
        )

    weights = EfficientNet_B0_Weights.DEFAULT
    mean = weights.transforms().mean
    std = weights.transforms().std

    train_tf = transforms.Compose([
        transforms.RandomResizedCrop(
            IMAGE_SIZE, scale=(0.75, 1.0)
        ),
        transforms.RandomHorizontalFlip(),
        transforms.RandomRotation(8),
        transforms.ColorJitter(
            brightness=0.12, contrast=0.12, saturation=0.05
        ),
        transforms.ToTensor(),
        transforms.Normalize(mean, std),
    ])

    val_tf = transforms.Compose([
        transforms.Resize(256),
        transforms.CenterCrop(IMAGE_SIZE),
        transforms.ToTensor(),
        transforms.Normalize(mean, std),
    ])

    train_ds = datasets.ImageFolder(train_dir, transform=train_tf)
    val_ds = datasets.ImageFolder(val_dir, transform=val_tf)

    if train_ds.classes != val_ds.classes:
        raise ValueError(
            "train과 val의 클래스 폴더 이름이 같아야 합니다."
        )

    if len(train_ds.classes) < 2:
        raise ValueError("최소 2개 이상의 등급 폴더가 필요합니다.")

    if len(train_ds) < 8 or len(val_ds) < 4:
        raise ValueError(
            "학습 사진은 최소 8장, 검증 사진은 최소 4장이 필요합니다. "
            "실제 성능을 위해서는 등급별로 훨씬 많은 사진을 권장합니다."
        )

    for name in train_ds.classes:
        count = sum(1 for _, y in train_ds.samples
                    if train_ds.classes[y] == name)
        val_count = sum(1 for _, y in val_ds.samples
                        if val_ds.classes[y] == name)
        print(f"{name}: 학습 {count}장 / 검증 {val_count}장")

        if count == 0 or val_count == 0:
            raise ValueError(f"{name} 등급의 사진이 부족합니다.")

    workers = 0  # Windows 노트북에서도 안정적으로 실행
    train_loader = DataLoader(
        train_ds, batch_size=BATCH_SIZE,
        shuffle=True, num_workers=workers
    )
    val_loader = DataLoader(
        val_ds, batch_size=BATCH_SIZE,
        shuffle=False, num_workers=workers
    )

    # ImageNet 사전학습 가중치로 시작하는 전이학습
    model = efficientnet_b0(weights=weights)
    in_features = model.classifier[1].in_features
    model.classifier[1] = nn.Linear(
        in_features, len(train_ds.classes)
    )
    model = model.to(device)

    # 우선 분류기를 학습하고, 이후 전체 네트워크를 미세 조정
    for param in model.features.parameters():
        param.requires_grad = False

    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.AdamW(
        filter(lambda p: p.requires_grad, model.parameters()),
        lr=1e-3,
        weight_decay=1e-4,
    )

    best_acc = -1.0
    best_loss = float("inf")
    best_state = copy.deepcopy(model.state_dict())
    stale_epochs = 0

    MODEL_DIR.mkdir(parents=True, exist_ok=True)

    for epoch in range(EPOCHS):
        # 두 번째 단계에서 특징 추출기도 조금씩 학습
        if epoch == 2:
            for param in model.features.parameters():
                param.requires_grad = True

            optimizer = torch.optim.AdamW([
                {"params": model.features.parameters(), "lr": 1e-5},
                {"params": model.classifier.parameters(), "lr": 2e-4},
            ], weight_decay=1e-4)

        for phase, loader in [
            ("train", train_loader), ("val", val_loader)
        ]:
            is_train = phase == "train"
            model.train(is_train)

            total_loss = 0.0
            total_correct = 0
            total_count = 0

            with torch.set_grad_enabled(is_train):
                for images, labels in loader:
                    images = images.to(device)
                    labels = labels.to(device)

                    if is_train:
                        optimizer.zero_grad(set_to_none=True)

                    logits = model(images)
                    loss = criterion(logits, labels)

                    if is_train:
                        loss.backward()
                        optimizer.step()

                    total_loss += loss.item() * labels.size(0)
                    total_correct += (
                        logits.argmax(1) == labels
                    ).sum().item()
                    total_count += labels.size(0)

            avg_loss = total_loss / max(total_count, 1)
            acc = total_correct / max(total_count, 1)

            print(
                f"Epoch {epoch + 1:02d}/{EPOCHS} | "
                f"{phase} loss={avg_loss:.4f} "
                f"accuracy={acc:.1%}"
            )

            if phase == "val":
                # 정확도가 같으면 검증 손실이 낮은 모델 선택
                improved = (
                    acc > best_acc or
                    (acc == best_acc and avg_loss < best_loss)
                )

                if improved:
                    best_acc = acc
                    best_loss = avg_loss
                    best_state = copy.deepcopy(model.state_dict())
                    stale_epochs = 0
                    torch.save({
                        "state_dict": best_state,
                        "classes": train_ds.classes,
                    }, MODEL_PATH)
                    print("  -> 최적 모델 저장")
                else:
                    stale_epochs += 1

        if stale_epochs >= PATIENCE:
            print("검증 성능 개선이 없어 조기 종료합니다.")
            break

    model.load_state_dict(best_state)

    INFO_PATH.write_text(
        json.dumps({
            "classes": train_ds.classes,
            "labels_kr": {
                name: LABELS_KR.get(name, name)
                for name in train_ds.classes
            },
            "validation_accuracy": best_acc,
            "validation_loss": best_loss,
            "train_images": len(train_ds),
            "validation_images": len(val_ds),
            "architecture": "EfficientNet-B0",
        }, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )

    print("\n학습 완료!")
    print(f"최고 검증 정확도: {best_acc:.1%}")
    print(f"모델 저장 위치: {MODEL_PATH}")
    print("주의: 검증 정확도는 새 사진에서의 정확도를 보장하지 않습니다.")


if __name__ == "__main__":
    main()


